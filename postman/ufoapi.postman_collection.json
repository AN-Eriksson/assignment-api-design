    {
      "name": "21 Sightings - Update with invalid payload should fail (400)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwtToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sightedAt\": \"not-a-datetime\",\n  \"durationSeconds\": \"bad\",\n  \"durationText\": \"invalid\",\n  \"comments\": \"invalid update payload\",\n  \"datePosted\": \"bad-date\",\n  \"locationId\": {{locationId}},\n  \"shapeId\": {{shapeId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sightings/{{sightingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sightings",
            "{{sightingId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get('baseUrl');",
              "const login = pm.environment.get('username');",
              "const password = pm.environment.get('password');",
              "",
              "pm.sendRequest({",
              "  url: `${baseUrl}/auth/login`,",
              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: {",
              "    mode: 'raw',",
              "    raw: JSON.stringify({ login, password })",
              "  }",
              "}, function (err, res) {",
              "  if (err) { throw new Error('Pre-request login failed: ' + err); }",
              "  if (res.code !== 200) { throw new Error('Pre-request login returned ' + res.code + ': ' + res.text()); }",
              "  const json = res.json();",
              "  if (!json.token) { throw new Error('Pre-request login did not return token'); }",
              "  pm.environment.set('jwtToken', json.token);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('JWT token exists', () => {",
              "  const token = pm.environment.get('jwtToken');",
              "  pm.expect(token, 'jwtToken missing; login did not run').to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Status is 400 or 401 (payload validation vs auth precedence)', () => {",
              "  pm.expect([400, 401]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
