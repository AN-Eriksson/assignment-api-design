  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) pm.environment.set('baseUrl', 'http://localhost:8080');",
          "",
          "// Reset run-scoped random data at the start of each collection run.",
          "if (pm.info.requestName && pm.info.requestName.startsWith('01 ')) {",
          "  pm.environment.set('runId', Date.now().toString());",
          "}",
          "",
          "const runId = pm.environment.get('runId') || Date.now().toString();",
          "pm.environment.set('runId', runId);",
          "pm.environment.set('username', `ufo_user_${runId}`);",
          "pm.environment.set('email', `ufo_${runId}@example.com`);",
          "pm.environment.set('password', 'Secret123!');",
          "",
          "if (!pm.environment.get('missingId')) pm.environment.set('missingId', '999999999');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Auth - Register success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type is JSON (application/json or application/hal+json)', () => {",
              "  const ct = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
              "  pm.expect(ct).to.match(/application\\/(hal\\+)?json/);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Safe response fields', () => {",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json).to.have.property('username', pm.environment.get('username'));",
              "  pm.expect(json).to.have.property('email', pm.environment.get('email'));",
              "  pm.expect(json.passwordHash).to.equal(undefined);",
              "});",
              "pm.environment.set('registeredUserId', json.id);"
            ]
          }
        }
      ]
    },
